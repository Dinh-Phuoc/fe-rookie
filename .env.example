# ===========================================
# FlashDev Web — Environment Variables
# ===========================================
# Copy file nay thanh .env.local (Next.js uu tien file nay khi dev):
#   cp .env.example .env.local      (Linux/macOS)
#   copy .env.example .env.local    (Windows)
#
# Hoac copy thanh .env neu ban muon dung chung cho moi truong.
#
# Luu y:
# - Bien bat dau NEXT_PUBLIC_ se duoc expose ra browser.
# - KHONG commit file .env / .env.local len Git.

# URL backend API (public — browser goi truc tiep)
# Dev: trung port voi api/.env (PORT=3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL cua trang web (dung cho sitemap, metadata, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
